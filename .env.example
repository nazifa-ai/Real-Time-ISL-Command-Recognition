# Copy to .env and edit.  Every value here is optional: config.py falls back to
# documented defaults when a variable is absent.  Never commit the real .env.

# ---- dataset locations ---------------------------------------------------
# Where the (optional) raw INCLUDE videos live, and where keypoints live.
# Default: <repo>/datasets/raw/INCLUDE and <repo>/datasets/raw/INCLUDE/keypoints/INCLUDE
# ISL_DATASET_PATH=/mnt/data/INCLUDE
# ISL_KEYPOINTS_PATH=/mnt/data/keypoints/Pose_Signs

# ai4bharat = official pre-extracted keypoints (default)
# mediapipe = re-extract from raw videos with this project's extractor
ISL_KEYPOINT_SOURCE=ai4bharat

# Axis units fix for the official release (measured; see docs/dataset_audit.md).
# Leave at the default unless you re-run training/calibrate_geometry.py.
ISL_X_AXIS_SCALE=3.1605
ISL_APPLY_KEYPOINT_AXIS_CORRECTION=true

# ---- reproducibility -----------------------------------------------------
ISL_RANDOM_SEED=42
ISL_SEQUENCE_LENGTH=30
ISL_VAL_FRACTION=0.10
# session_disjoint (default) = leak-free primary evaluation; official = AI4Bharat split
ISL_SPLIT_PROTOCOL=session_disjoint

# ---- training ------------------------------------------------------------
ISL_BATCH_SIZE=32
ISL_EPOCHS=80
ISL_LEARNING_RATE=0.001
ISL_DROPOUT=0.3

# ---- inference behaviour -------------------------------------------------
ISL_CONFIDENCE_THRESHOLD=0.70
ISL_SMOOTHING_WINDOW=3
ISL_TTS_COOLDOWN=3.0
ISL_DEFAULT_MODEL=gru_mha
ISL_CAMERA_INDEX=0

# ---- text to speech ------------------------------------------------------
# auto | gtts | pyttsx3 | none
ISL_TTS_ENGINE=auto
ISL_TTS_ENABLED=true

# ---- backend / frontend --------------------------------------------------
ISL_API_HOST=0.0.0.0
ISL_API_PORT=8000
ISL_API_BASE_URL=http://localhost:8000
ISL_FRONTEND_PORT=8501

# ---- privacy -------------------------------------------------------------
# Keep false: uploaded videos are processed in memory and never written to disk.
ISL_PERSIST_UPLOADS=false
ISL_MAX_UPLOAD_MB=200
